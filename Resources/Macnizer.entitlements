<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The hardened runtime is mandatory for notarisation, and it blocks Apple
      Events by default. Without this entitlement the Tabs pane silently stops
      working in a notarised build: NSAppleScript cannot reach the browsers.

      Accessibility (AXUIElement) needs no entitlement — it is gated purely by
      the user's Privacy & Security approval — so the window tiling is
      unaffected either way.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Snaple's screen recording: microphone narration and webcam overlay.
         Non-sandboxed, so no keychain-access-groups needed (Snaple's session
         uses the default keychain, no access group). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
